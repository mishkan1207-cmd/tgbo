# Локальные служебные файлы — в репозиторий не попадают.
.tools/
*.log
__pycache__/
*.pyc
venv/
.venv/

# История постов: файл состояния нужно коммитить, иначе не работает
# защита от дублей между запусками. Содержимое каталога игнорируем,
# но сам файл — нет.
state/*
!state/posted.json

# Никогда не коммитим ключи и токены.
gh_token.txt
device_code.json
*_key.txt
.env
